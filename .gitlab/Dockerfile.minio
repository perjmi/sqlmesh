# SPDX-License-Identifier: Apache-2.0
# Official release binaries replace the blocked Chainguard registry in CI.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL --retry 3 \
    https://github.com/minio/minio/releases/download/RELEASE.2025-09-07T16-13-09Z/minio.linux-amd64.RELEASE.2025-09-07T16-13-09Z \
    -o /usr/bin/minio \
    && printf '%s  %s\n' 7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f /usr/bin/minio | sha256sum -c - \
    && curl -fsSL --retry 3 \
    https://github.com/minio/mc/releases/download/RELEASE.2025-08-13T08-35-41Z/mc.linux-amd64.RELEASE.2025-08-13T08-35-41Z \
    -o /usr/bin/mc \
    && printf '%s  %s\n' 01f866e9c5f9b87c2b09116fa5d7c06695b106242d829a8bb32990c00312e891 /usr/bin/mc | sha256sum -c - \
    && chmod +x /usr/bin/minio /usr/bin/mc \
    && minio --version && mc --version
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
    org.opencontainers.image.version="RELEASE.2025-09-07T16-13-09Z"
ENTRYPOINT ["/usr/bin/minio"]
