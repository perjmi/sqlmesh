#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
# Upstream's strict type-check configuration describes its original tree. The
# personal harness has standalone imports and historical benchmark scripts;
# retain Ruff checks for it and run its regressions in the dedicated job.
args=()
for arg in "$@"; do
    case "$arg" in
        examples/randomgraphs/*|*/examples/randomgraphs/*) ;;
        *) args+=("$arg") ;;
    esac
done
if [[ ${#args[@]} -gt 0 ]]; then
    exec python -m mypy "${args[@]}"
fi
