ARG CANDIDATE_SQLMESH_IMAGE=sqlmesh-candidate:latest
FROM mirror.gcr.io/library/docker:27.5.1-cli AS docker_cli

FROM ${CANDIDATE_SQLMESH_IMAGE}

COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/
RUN pip install pytest==9.1.1
